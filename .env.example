# Copy to .env and chmod 600 it.

# --- Nightscout ---------------------------------------------------------------
# URL as seen from the container. Inside the same docker network as Nightscout
# use the service name; otherwise your public https URL.
NS_URL=http://nightscout:1337
# A READ-ONLY token (subject with role "readable"), NOT your API_SECRET. See README.
NS_TOKEN=
# Docker network where Nightscout lives. Leave empty if NS_URL is public.
DOCKER_NETWORK=nightscout_default

# --- LibreView (the account your clinic is linked to) -------------------------
LV_USER=you@example.com
LV_PASS=

# --- Alerts from sync-diario.sh (all optional) --------------------------------
# E-mail on failure / no new readings. Empty MAIL_TO disables e-mail.
MAIL_TO=
MAIL_FROM=
# Command that reads an RFC 822 message on stdin and takes the recipient as argument.
MAIL_CMD="sudo msmtp -a default"
# healthchecks.io ping URL: also warns you when the cron does NOT run at all.
HC_PING_URL=
